# Copy this file to .env and fill in real values. The real .env never enters the repo.

# --- API ---
# Port the Express API listens on.
API_PORT=4000
# Public base URL of the API, used to build tracking links.
API_BASE_URL=http://localhost:4000
# Allowed browser origin for CORS (the web app).
WEB_ORIGIN=http://localhost:5180
# Node environment: development | test | production.
NODE_ENV=development

# --- Database (PostgreSQL 16) ---
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://baitward:baitward@localhost:5432/baitward?schema=public

# --- Redis (queues) ---
# Matches the redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# --- Email (SMTP) ---
# In development these point at Mailpit, which captures mail instead of sending it.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Default From address for simulated campaigns.
MAIL_FROM="Baitward <no-reply@baitward.local>"

# --- Auth secrets ---
# Signs short-lived access tokens (min 32 chars). Generate: openssl rand -base64 48
AUTH_ACCESS_SECRET=dev-access-secret-change-me-in-production-0000
# Passphrase from which the TOTP-secret encryption key is derived (min 16 chars).
TOTP_ENC_KEY=dev-totp-encryption-key-change-me-in-prod-0000
