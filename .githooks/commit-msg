#!/bin/sh
# Reject any commit message that carries an AI-attribution line.
# Every commit must read as the author's own work.
PATTERN="co-authored-by:.*claude|noreply@anthropic|generated with.*claude|generated by.*claude"
if grep -qiE "$PATTERN" "$1"; then
  echo "commit-msg hook: the message contains an AI-attribution line. Remove it and commit again."
  exit 1
fi
exit 0
